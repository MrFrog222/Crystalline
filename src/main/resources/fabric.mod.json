{
  "schemaVersion": 1,
  "id": "crystalline",
  "version": "${version}",
  "name": "Crystalline",
  "description": "Addon for Meteor Client mainly focusing on legit cpvp and general utility.",
  "authors": [
    "MrFrog222"
  ],
  "contact": {
    "sources": "https://github.com/MrFrog222/Crystalline"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
